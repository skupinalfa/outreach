# Copy to .env and fill in.

# --- Required at boot ---
DATABASE_URL=postgresql+psycopg://coldmail:coldmail@postgres:5432/coldmail
FERNET_KEY=  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET=  # python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- First-run only ---
# Removed after the master password is bootstrapped through the UI.
INITIAL_MASTER_PASSWORD=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional seed for external services (bypass Settings UI for dev) ---
# HUNTER_API_KEY=
# OPENAI_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SENDER_DISPLAY_NAME=
# SENDER_EMAIL=
